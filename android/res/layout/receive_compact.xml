<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/offer_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Receber arquivos?" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:paddingEnd="6dp" style="@android:style/TextAppearance.Material.Notification.Title"/>
  <Button android:id="@+id/offer_accept" android:layout_width="76dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:text="Aceitar" android:textSize="12sp" android:textAllCaps="false" android:textColor="#244D40"/>
  <Button android:id="@+id/offer_reject" android:layout_width="76dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="2dp" android:text="Recusar" android:textSize="12sp" android:textAllCaps="false" android:textColor="#A34536"/>
</LinearLayout>
